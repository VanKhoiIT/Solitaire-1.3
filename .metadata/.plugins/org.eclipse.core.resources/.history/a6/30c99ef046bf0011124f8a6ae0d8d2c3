package ca.mcgill.solitaire.cards;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

/**
 * Represents a deck of cards.
 */
public class Deck {

    // Biến nhận cấu hình bài từ dòng lệnh (main)
    public static int CONFIGURATION_INDEX = 1;

    private final List<Card> aCards = new ArrayList<>();

    public Deck() {
        shuffle();
    }

    /**
     * Initializes and shuffles or configures the deck.
     */
    public void shuffle() {
        aCards.clear();
        for (Suit suit : Suit.values()) {
            for (Rank rank : Rank.values()) {
                aCards.add(Card.get(rank, suit));
            }
        }

        if (CONFIGURATION_INDEX > 0) {
            // Đảo ngược thứ tự để tạo thế bài cố định theo cấu hình
            Collections.reverse(aCards);
        } else {
            Collections.shuffle(aCards);
        }
    }

    /**
     * Adds a card to the top of the deck.
     */
    public void push(Card pCard) {
        assert pCard != null;
        aCards.add(pCard);
    }

    /**
     * Removes and returns the top card of the deck.
     */
    public Card pop() {
        assert !isEmpty();
        return aCards.remove(aCards.size() - 1);
    }

    /**
     * Returns true if the deck has no cards.
     */
    public boolean isEmpty() {
        return aCards.isEmpty();
    }

    /**
     * Returns the number of cards in the deck.
     */
    public int size() {
        return aCards.size();
    }
}