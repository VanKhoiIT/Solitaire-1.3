package ca.mcgill.solitaire.cards;

import java.util.ArrayList;
import java.util.List;

/**
 * Represents a deck of 52 cards constructed with a pre-determined order
 * that allows a player to win the game.
 */
public class Deck {
	
	public static int CONFIGURATION_INDEX = 1;

	private CardStack aCards;

	public Deck() {
		initialize(CONFIGURATION_INDEX);
	}

	public Deck(int pConfiguration) {
		initialize(pConfiguration);
	}

	public void initialize(int pConfig) {
		Suit[] suits;
		switch (pConfig) {
			case 2:
				suits = new Suit[]{Suit.SPADES, Suit.HEARTS, Suit.DIAMONDS, Suit.CLUBS};
				break;
			case 3:
				suits = new Suit[]{Suit.HEARTS, Suit.SPADES, Suit.CLUBS, Suit.DIAMONDS};
				break;
			case 1:
			default:
				suits = new Suit[]{Suit.CLUBS, Suit.DIAMONDS, Suit.HEARTS, Suit.SPADES};
				break;
		}

		// Tao du 52 la bai theo thu tu Rank tu Ace -> King
		List<Card> allCards = new ArrayList<>();
		for (Rank rank : Rank.values()) {
			for (Suit suit : suits) {
				allCards.add(Card.get(rank, suit));
			}
		}

		// Thiet lap thu tu sao cho sau khi chia 28 la ra 7 cot,
		// toan bo bai nho va At duoc giai phong hoan toan khi bam Enter
		List<Card> dealOrder = new ArrayList<>();
		
		// 28 la bai chia vao 7 cot Tableau (lat tu tren xuong)
		for (int i = 0; i < 28; i++) {
			dealOrder.add(allCards.get(i));
		}
		
		// 24 la con lai nam trong coc rut (Deck)
		for (int i = 28; i < 52; i++) {
			dealOrder.add(allCards.get(i));
		}

		// Nap vao Stack theo chieu nguoc de la dau tien rut ra o vi tri tren cung
		List<Card> stackCards = new ArrayList<>();
		for (int i = dealOrder.size() - 1; i >= 0; i--) {
			stackCards.add(dealOrder.get(i));
		}

		aCards = new CardStack(stackCards);
	}

	public void shuffle() {
		initialize(CONFIGURATION_INDEX);
	}

	public void push(Card pCard) {
		assert pCard != null;
		aCards.push(pCard);
	}

	public Card draw() {
		assert !isEmpty();
		return aCards.pop();
	}

	public Card pop() {
		return draw();
	}

	public boolean isEmpty() {
		return aCards.isEmpty();
	}

	public int size() {
		return aCards.size();
	}
}