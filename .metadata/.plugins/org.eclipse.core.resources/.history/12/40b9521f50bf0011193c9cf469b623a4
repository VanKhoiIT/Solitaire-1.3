package ca.mcgill.solitaire.cards;

import java.util.ArrayList;
import java.util.List;

/**
 * Represents a deck of 52 cards constructed with a pre-determined order
 * that allows a player to win the game.
 */
public class Deck {
	
	public static int CONFIGURATION_INDEX = 1;

	private CardStack aCards;

	public Deck() {
		initialize(CONFIGURATION_INDEX);
	}

	public Deck(int pConfiguration) {
		initialize(pConfiguration);
	}

	public void initialize(int pConfig) {
		List<Card> cards = new ArrayList<>();

		Suit[] suits;
		switch (pConfig) {
			case 2:
				suits = new Suit[]{Suit.SPADES, Suit.HEARTS, Suit.DIAMONDS, Suit.CLUBS};
				break;
			case 3:
				suits = new Suit[]{Suit.HEARTS, Suit.SPADES, Suit.CLUBS, Suit.DIAMONDS};
				break;
			case 1:
			default:
				suits = new Suit[]{Suit.CLUBS, Suit.DIAMONDS, Suit.HEARTS, Suit.SPADES};
				break;
		}

		// 1. Cho 28 lá bài lớn (từ 7 đến King) vào trước để chia hết vào 7 cột trên bàn
		for (Suit suit : suits) {
			Rank[] ranks = Rank.values();
			for (int i = 6; i < ranks.length; i++) {
				cards.add(Card.get(ranks[i], suit));
			}
		}

		// 2. Cho 24 lá bài nhỏ (từ 6 lùi về Ace) vào sau
		// Để khi đưa vào Stack, các con Át (Ace) sẽ nằm ở ĐỈNH CỌC RÚT
		// Khi nhấn Enter, cọc rút sẽ bắn lần lượt: A -> 2 -> 3 -> 4 -> 5 -> 6 lên thẳng 4 ô trên cùng!
		for (int r = 5; r >= 0; r--) {
			for (Suit suit : suits) {
				cards.add(Card.get(Rank.values()[r], suit));
			}
		}

		aCards = new CardStack(cards);
	}

	public void shuffle() {
		initialize(CONFIGURATION_INDEX);
	}

	public void push(Card pCard) {
		assert pCard != null;
		aCards.push(pCard);
	}

	public Card draw() {
		assert !isEmpty();
		return aCards.pop();
	}

	public Card pop() {
		return draw();
	}

	public boolean isEmpty() {
		return aCards.isEmpty();
	}

	public int size() {
		return aCards.size();
	}
}