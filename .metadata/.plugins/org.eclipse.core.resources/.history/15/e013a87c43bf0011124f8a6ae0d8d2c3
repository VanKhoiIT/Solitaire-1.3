package ca.mcgill.solitaire.gui;

import ca.mcgill.solitaire.cards.Deck;
import javafx.application.Application;
import javafx.geometry.Insets;
import javafx.scene.Scene;
import javafx.scene.layout.GridPane;
import javafx.stage.Stage;

/**
 * Main class for the Solitaire application.
 */
public class Solitaire extends Application {
	
	private static final int WIDTH = 680;
	private static final int HEIGHT = 500;
	private static final int MARGIN = 10;
	
	@Override
	public void start(Stage pPrimaryStage) {
		pPrimaryStage.setTitle("Solitaire");
		pPrimaryStage.setResizable(false);
		
		GridPane root = new GridPane();
		root.setHgap(MARGIN);
		root.setVgap(MARGIN);
		root.setPadding(new Insets(MARGIN));
		
		DeckView deckView = new DeckView();
		DiscardPileView discardPileView = new DiscardPileView();
		SuitStack suitStack = new SuitStack();
		CardPileView cardPileView = new CardPileView();
		
		root.add(deckView, 0, 0);
		root.add(discardPileView, 1, 0);
		root.add(suitStack, 3, 0, 4, 1);
		root.add(cardPileView, 0, 1, 7, 1);
		
		pPrimaryStage.setScene(new Scene(root, WIDTH, HEIGHT));
		pPrimaryStage.show();
	}
	
	public static void main(String[] args) {
		if (args.length > 0) {
			try {
				int config = Integer.parseInt(args[0]);
				Deck.CONFIGURATION_INDEX = config;
				System.out.println("Loaded winnable deck configuration: " + config);
			} catch (NumberFormatException e) {
				System.err.println("Invalid configuration argument. Using default (1).");
			}
		}
		launch(args);
	}
}