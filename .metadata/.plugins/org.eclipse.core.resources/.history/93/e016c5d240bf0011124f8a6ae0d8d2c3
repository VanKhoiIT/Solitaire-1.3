package ca.mcgill.solitaire.cards;

import java.util.ArrayList;
import java.util.Collections;
import java.util.Iterator;
import java.util.List;

/**
 * Deck class modified to construct pre-determined winnable card configurations
 * instead of a random shuffled deck.
 */
public class Deck implements Iterable<Card> {

	// Cấu hình được chọn từ dòng lệnh (mặc định cấu hình 1)
	public static int CONFIGURATION_INDEX = 1;

	private final List<Card> aCards = new ArrayList<>();

	/**
	 * Creates a new deck with a pre-determined winnable configuration.
	 */
	public Deck() {
		buildWinnableDeck(CONFIGURATION_INDEX);
	}

	/**
	 * Constructor cho phép khởi tạo trực tiếp với mã cấu hình mong muốn.
	 */
	public Deck(int pConfiguration) {
		buildWinnableDeck(pConfiguration);
	}

	private void buildWinnableDeck(int pConfig) {
		aCards.clear();
		switch (pConfig) {
		case 2:
			// Cấu hình 2: Bố trí theo thứ tự từng chất từ Ace đến King
			for (Suit suit : Suit.values()) {
				for (Rank rank : Rank.values()) {
					aCards.add(Card.get(rank, suit));
				}
			}
			break;

		case 3:
			// Cấu hình 3: Đảo ngược thứ tự các chất
			Suit[] suits = Suit.values();
			for (int i = suits.length - 1; i >= 0; i--) {
				for (Rank rank : Rank.values()) {
					aCards.add(Card.get(rank, suits[i]));
				}
			}
			break;

		case 1:
		default:
			// Cấu hình 1 (Thắng siêu nhanh):
			// Xếp tất cả 52 lá bài tuần tự theo rank từ ACE -> KING
			// Khi rút theo thứ tự này, người chơi có thể dễ dàng giải bàn cờ
			for (Rank rank : Rank.values()) {
				for (Suit suit : Suit.values()) {
					aCards.add(Card.get(rank, suit));
				}
			}
			break;
		}
	}

	/**
	 * Draws a card from the deck.
	 * 
	 * @return The drawn card.
	 * @pre !isEmpty()
	 */
	public Card draw() {
		assert !isEmpty();
		// Rút quân bài đầu tiên trong danh sách đã xếp sẵn
		return aCards.remove(0);
	}

	/**
	 * @return True if there are no cards in the deck.
	 */
	public boolean isEmpty() {
		return aCards.isEmpty();
	}

	/**
	 * @return The number of cards remaining in the deck.
	 */
	public int size() {
		return aCards.size();
	}

	@Override
	public Iterator<Card> iterator() {
		return Collections.unmodifiableList(aCards).iterator();
	}
}